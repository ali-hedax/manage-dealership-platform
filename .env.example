# HEDAX — optional configuration variables (safe example values).
#
# Nothing loads a .env file automatically: not start-hedax.cmd, not
# companion/start.cjs, not companion/server.cjs. Set a variable in the shell,
# or load a copy of this file explicitly with Node's built-in flag:
#
#   copy .env.example .env
#   node --env-file=.env companion/server.cjs
#
# (--env-file fails if the file is missing. A companion started this way is
# not stopped by the "HEDAX: Stop running companion (verified)" task, whose
# identity check requires server.cjs as Node's first argument; stop it with
# Ctrl+C in its terminal.) The VS Code debug configurations
# in .vscode/launch.json set their own values and do not read .env.
#
# There are no B2B credentials here, by design. Signing in to B2B is done by
# hand in the dedicated Chrome window; never put a username, password, cookie,
# token or browser-session content in any env file.

# Port for the local companion when started directly (npm start /
# node companion/server.cjs). Default: 5173.
# NOT used by start-hedax.cmd: the launcher always uses 5173 and opens
# http://localhost:5173/. A different port is a different browser origin, so
# the dashboard there has its own, separate IndexedDB data.
HEDAX_PORT=5173

# Port for the synthetic preview in tests/management-browser.cjs. Default: 5178.
HEDAX_TEST_PORT=5178
