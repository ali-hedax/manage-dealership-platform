# --- داده‌های واقعی نمایندگی: هرگز وارد مخزن نشوند ---
# خروجی‌های اکسل سامانه (موجودی، گردش، امداد، پذیرش، نوبت‌دهی)
*.xls
*.xlsx
*.xlsm
*.xlsb
*.ods
*.csv
*.tsv

# پایگاه دادهٔ محلی و خروجی‌های گرفته‌شده از داشبورد
*.sqlite
*.sqlite3
*.db
/data/
/exports/
/downloads/

# --- رمزها و توکن‌ها ---
.env
.env.*
# الگوی بدون مقدار واقعی؛ باید در مخزن بماند
!.env.example
*.pem
*.key
*.pfx
secrets.json
credentials.json
.netrc

# --- ابزار و سیستم ---
node_modules/
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini
# فقط پیکربندی مشترک VS Code در مخزن؛ تنظیمات شخصی بیرون می‌ماند
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.tmp
*.bak
*~

# Local B2B session and logs
.local/
*.log
playwright-report/
test-results/
coverage/
.nyc_output/
# ردگیری شبکه و Playwright ممکن است کوکی نشست B2B داشته باشد
*.har
trace*.zip
