# Manage by HEDAX production reverse proxy. Mounted by operational.yml.
# Canonical address: https://managebyhedax.ir (every other name answers 301).
#
# Public traffic arrives through the ArvanCloud proxy, which holds the certificate
# visitors see. The static Let's Encrypt pair here secures Arvan-to-origin HTTPS.
# This VM cannot reach any ACME server; see docs/DEPLOYMENT.md.
{
	# Plain-HTTP redirects are declared below so they are 301, not Caddy's 308.
	auto_https disable_redirects
	skip_install_trust
	# Clients connecting by IP send no SNI; without this the handshake fails.
	default_sni 85.198.52.255
	servers {
		# Official list: https://www.arvancloud.ir/fa/ips.txt (fetched 2026-11-05).
		# Refresh when Arvan changes it, or real client addresses are lost.
		trusted_proxies static 185.143.232.0/22 188.229.116.16/30 94.101.182.0/27 2.144.3.128/28 37.32.16.0/27 37.32.17.0/27 37.32.18.0/27 37.32.19.0/27 185.215.232.0/22 178.131.120.48/28 94.101.183.0/28 78.157.36.112/28 95.38.61.80/28 193.24.119.0/29
		# Read X-Forwarded-For right to left: left-hand values are client-supplied.
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

(canonical_redirect) {
	header -Server
	redir https://managebyhedax.ir{uri} 301
}

http:// {
	handle_path /.well-known/acme-challenge/* {
		root * /srv/acme
		file_server
	}
	handle {
		import canonical_redirect
	}
}

managebyhedax.ir {
	tls /etc/caddy/tls/fullchain.pem /etc/caddy/tls/privkey.pem
	encode zstd gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy "same-origin"
		-Server
	}
	# The API takes the right-most X-Forwarded-For value (trust proxy = 1), so it
	# receives only the verified client address, never a client-supplied list.
	reverse_proxy gate:8080 {
		header_up X-Forwarded-For {client_ip}
	}
}

www.managebyhedax.ir {
	tls /etc/caddy/tls/fullchain.pem /etc/caddy/tls/privkey.pem
	import canonical_redirect
}

# Former temporary name: old bookmarks and invitation links keep working.
manage-85-198-52-255.sslip.io {
	import canonical_redirect
}

# A public certificate is not available for the raw IP, so browsers warn once.
https://85.198.52.255 {
	tls internal
	import canonical_redirect
}
